+        assert lease.inspect_optional() is None
+        assert calls == []
+    finally:
+        if process.poll() is None:
+            process.stdin.write("release\n")
+            process.stdin.flush()
+        process.wait(timeout=5)
+        asyncio.run(client.aclose())
